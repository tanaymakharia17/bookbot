# Postgres
POSTGRES_USER=bookbot
POSTGRES_PASSWORD=bookbot
POSTGRES_DB=bookbot
DATABASE_URL=postgres://bookbot:bookbot@postgres:5432/bookbot

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
DEFAULT_FIRM_NAME=Default Firm

# VLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VLM_MODEL=qwen/qwen3.7-flash
AGENT_MODEL=qwen/qwen3.7-flash
AGENT_CONTEXT_MAX_TOKENS=60000
AGENT_SUBMISSION_TOKEN_BUDGET=300000

# Frontend
BOOKBOT_BACKEND_URL=http://backend:8000
BOOKBOT_BACKEND_PUBLIC_URL=http://localhost:8500
BOOKBOT_API_MODE=real
